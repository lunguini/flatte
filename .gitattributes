# All internal docs live under .docs/ (encrypted). There is no .specs/ folder;
# its rule is kept only as a safety guard so a stray file there can never be
# committed as plaintext.
.docs/** filter=git-crypt diff=git-crypt
.specs/** filter=git-crypt diff=git-crypt

# Golden snapshots are byte-compared by tests; never let a CRLF checkout
# (e.g. Windows CI runners) rewrite their line endings.
*.golden -text

# Keep security-sensitive leaderboard validation reviewable even when an older
# blob contains literal control bytes. Current sources use explicit escapes.
leaderboard/src/board.js text eol=lf diff
leaderboard/test/logic.test.mjs text eol=lf diff
