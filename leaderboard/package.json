{
  "name": "flatte-leaderboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + KV shared leaderboard for the Flatte Snake demo, with deterministic wasm replay verification.",
  "scripts": {
